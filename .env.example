# ==========================================
# E-Commerce Microservices V2 Configuration
# ==========================================

# Security & Authentication
JWT_SECRET=SuperSecretSigningKeyForEcommercePlatform3YearExpSecretKey
JWT_EXPIRATION_MS=86400000

# Distributed Tracing & Observability
CORRELATION_ID_HEADER=X-Correlation-ID

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDER_CREATED=order-created-topic
KAFKA_TOPIC_PAYMENT_APPROVED=payment-approved-topic
KAFKA_TOPIC_USER_REGISTERED=user-registered-topic
KAFKA_DLQ_SUFFIX=.DLT

# Redis & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20

# Microservice Service Ports
PORT_GATEWAY=8080
PORT_USER_SERVICE=8081
PORT_PRODUCT_SERVICE=8082
PORT_PAYMENT_SERVICE=8083
PORT_ORDER_SERVICE=8084
PORT_NOTIFICATION_SERVICE=8085
